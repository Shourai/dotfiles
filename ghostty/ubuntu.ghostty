# Ubuntu-only ghostty settings (GNOME desktop), loaded from config.ghostty (via os.ghostty)

# Apple's SF Mono, downloaded by setup/ubuntu.sh (install_apple_fonts); icons are built into ghostty
font-family = "SF Mono"

# Title bar stays on (GNOME doesn't tile), in the theme's colours instead of GNOME's grey
window-theme = ghostty

# No transparency
background-opacity = 1

# New windows open maximized (GNOME's top bar stays); Ctrl+Enter toggles fullscreen
maximize = true

# Keep running after the last window closes: ghostty starts at login without a window
# (ubuntu/ghostty-autostart.desktop) and the shortcuts open windows in it, so they're instant
quit-after-last-window-closed = false
