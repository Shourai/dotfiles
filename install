#!/usr/bin/env bash
# Bootstrap a fresh Arch Linux or macOS machine, or bring an existing one up to date.
# Safe to rerun.
#
#   curl -fsSL https://raw.githubusercontent.com/Shourai/dotfiles/main/install | bash -s -- [flags]
#   ~/Documents/github/dotfiles/install [flags]
#
#   --extras     also install the optional packages (packages/extras-*.txt)
#   --defaults   also apply macOS system settings (macos/defaults.sh)
#   --dry-run    print what would change without changing anything
#
# Steps: install git -> clone dotfiles and nvim -> packages -> links -> zsh.
# Each step is also its own script in setup/ and can be run on its own.

set -euo pipefail

DOTFILES="$HOME/Documents/github/dotfiles"
NVIM_CONFIG="$HOME/Documents/github/nvim"

# This file runs before the repo is cloned, so it can't use setup/lib.sh yet
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if [ "${DRY_RUN:-0}" = 1 ]; then printf '  \033[2m[dry-run]\033[0m %s\n' "$*"; else "$@"; fi; }

# Clone one of my GitHub repos, unless it is already there
clone() {
  local name="$1" dir="$2"
  if [ -d "$dir/.git" ]; then
    echo "  $dir already exists"
  else
    run git clone --quiet "https://github.com/Shourai/$name.git" "$dir"
    # Cloned over https (no SSH key needed yet); push over SSH from now on
    run git -C "$dir" remote set-url origin "git@github.com:Shourai/$name.git"
  fi
}

# Wrapped in main so bash reads the whole file before running it (needed for curl | bash)
main() {
  # Flags are checked here and passed on to the setup scripts
  DRY_RUN=0
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN=1 ;;
      --extras|--defaults) ;;
      -h|--help) sed -n '2,13p' "$0" 2>/dev/null | sed 's/^# \{0,1\}//'; exit 0 ;;
      *) die "unknown option: $arg (see --help)" ;;
    esac
  done

  if [ "$(uname)" = "Darwin" ]; then
    os=macos
  elif [ -f /etc/arch-release ]; then
    os=arch
  else
    die "unsupported system: only Arch Linux and macOS"
  fi

  # Ask for the password once and keep sudo alive until this script exits
  if [ "$DRY_RUN" = 0 ]; then
    sudo -v
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
  fi

  info "Installing git"
  if [ "$os" = macos ]; then
    # Homebrew installs the Xcode command line tools, which include git
    if ! command -v brew >/dev/null 2>&1; then
      run env NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
    run brew install git
  else
    run sudo pacman -Syu --needed --noconfirm git
  fi

  info "Cloning repositories"
  clone dotfiles "$DOTFILES"
  clone nvim "$NVIM_CONFIG"

  # The setup scripts come from the clone; in a dry run on a fresh machine there is none yet
  [ -d "$DOTFILES/setup" ] || die "$DOTFILES/setup not found (dry run on a fresh machine?)"

  bash "$DOTFILES/setup/$os.sh" "$@"
  bash "$DOTFILES/setup/link.sh" "$@"
  bash "$DOTFILES/setup/zsh.sh" "$@"

  info "Done! Reboot (or log out and back in) for everything to take effect."
}

main "$@"
