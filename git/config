# Global git config, linked to ~/.config/git/config. See README.md in this folder.

# ----------------------------------------
# - Branches & remotes                   -
# ----------------------------------------

[init]
  defaultBranch = main

[pull]
  ff = only                # refuse to pull when branches have diverged; decide by hand

[push]
  autoSetupRemote = true   # first push of a new branch needs no -u

[fetch]
  prune = true             # delete local refs to branches removed on the remote

[branch]
  sort = -committerdate    # most recently used branches first

# ----------------------------------------
# - Diffs & merges                       -
# ----------------------------------------

[diff]
  algorithm = histogram
  colorMoved = default     # moved lines in a different colour

[merge]
  conflictStyle = zdiff3   # conflict markers also show the original text

# delta (packages/common.txt) shows diffs, log -p, show and add -p with syntax highlighting;
# where it isn't installed, git falls back to less / plain output
[core]
  pager = command -v delta >/dev/null && exec delta || exec less

[interactive]
  diffFilter = command -v delta >/dev/null && exec delta --color-only || exec cat

[delta]
  navigate = true
  dark = true
  true-color = auto

  # Colours: One Dark (README.md, Theme). The line backgrounds are dark so syntax colours
  # stay readable on them; the changed words (emph) are a step brighter.

  # Line numbers: unchanged lines dim, removed red, added green
  line-numbers = true
  line-numbers-left-style = "#4b5263"
  line-numbers-right-style = "#4b5263"
  line-numbers-minus-style = "#e06c75"
  line-numbers-plus-style = "#98c379"
  line-numbers-zero-style = "#7f848e"

  # Added lines
  plus-style = "syntax #2b4235"
  plus-emph-style = "syntax #3b5e48"

  # Deleted lines
  minus-style = "syntax #4a2a31"
  minus-emph-style = "syntax #6b3540"

[rerere]
  enabled = true           # remember conflict resolutions and reuse them

# ----------------------------------------
# - Aliases                              -
# ----------------------------------------

[alias]
  a = add
  aa = add --all
  b = branch
  ba = branch -a
  bd = branch -d
  c = commit -v
  ca = commit -v -a
  cam = commit -a -m
  cb = checkout -b
  cm = !git checkout \"$(git default-branch)\"
  cmsg = commit -m
  co = checkout
  d = diff
  ds = diff --staged
  f = fetch
  l = pull
  m = merge
  mom = !git merge \"origin/$(git default-branch)\"
  p = push
  pv = push -v
  r = remote
  ra = remote add
  rv = remote -v
  sb = status -sb
  ss = status -s
  st = status
  lg = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset' -20

  # Name of the default branch: origin's HEAD, else main if it exists, else master
  default-branch = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && echo \"${b#origin/}\" || { git show-ref -q --verify refs/heads/main && echo main || echo master; }"

# ----------------------------------------
# - Identity per folder                  -
# ----------------------------------------

# Never guess a name/email (e.g. user@host.local on a Mac); outside the folders below,
# git refuses to commit until an identity is set
[user]
  useConfigOnly = true

[includeIf "gitdir:~/Documents/github/**"]
  path = ~/.config/git/gitconfig_personal

# Local only, not in the repo (see README.md)
[includeIf "gitdir:~/Documents/gitlab/**"]
  path = ~/.config/git/gitconfig_work
