# Sourced from .zshrc, after PATH (Homebrew) is set up.
# Guarded where the tool might be missing and there's a sensible fallback (ls, cat, vi).

# --- LISTING (eza) ---

if (( $+commands[eza] )); then
  alias ls='eza --icons=auto --group-directories-first'                                  # plain
  alias l='eza --long --icons=auto --group-directories-first'                            # long
  alias ll='eza --long --all --icons=auto --group-directories-first --git'               # + hidden, git status
  alias lll='eza --long --all --header --group --icons=auto --group-directories-first --git'  # + header, group
  alias lt='eza --tree --level=2 --icons=auto'                                           # tree, 2 levels
fi

# --- VIEWING (bat) ---

(( $+commands[bat] )) && alias cat='bat --paging=never'

# --- NAVIGATION ---

alias ..='cd ../'
alias ...='cd ../..'
alias ....='cd ../../..'
alias cd..='cd ../'
alias /='cd /'
alias ~='cd ~'

# --- SAFER DEFAULTS ---

alias cp='cp -iv'        # ask before overwriting, show what's copied
alias mkdir='mkdir -pv'  # create parents, show what's created

# --- EDITOR ---

if (( $+commands[nvim] )); then
  alias vi='nvim'
  alias vim='nvim'
fi
alias zshrc='$EDITOR $ZDOTDIR/.zshrc'  # edit this config

# --- WIREGUARD ---

alias wgup='wg-quick up'
alias wgdown='wg-quick down'

# --- GIT ---

alias g='git'
alias lg='lazygit'

# --- ARCH ---

# Pick explicitly installed packages to remove
if [[ -n "$IS_ARCH" ]]; then
  alias pkg-clean="pacman -Qetq | fzf -m --preview 'pacman -Qi {}' | xargs -o -r sudo pacman -Runs"
fi
