# Files that tools or setup create inside this repo's (linked) folders.

# macOS Finder metadata
.DS_Store
._*

# setup/link.sh: backups of files that were in the way of a link
*.bak-*

# ghostty: per-OS link created by setup/link.sh
ghostty/os.ghostty

# git: work identity, created by hand on each machine (see git/README.md)
git/gitconfig_work

# yazi: installed by `ya pkg install` from yazi/package.toml
yazi/flavors/
yazi/plugins/

# zsh: history and completion cache live in ~/.local/state and ~/.cache now.
# Kept as a safety net: shell history can contain secrets.
zsh/history
zsh/.zcompdump
